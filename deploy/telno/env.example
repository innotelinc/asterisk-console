# Telno on 192.168.1.53 — copy to `.env` beside docker-compose.53.yml.
#
# No secret belongs in this file in the repository. SESSION_SECRET, the AMI
# secret and the switch certificate self-generate on first boot and live on the
# `telno-data` volume; provider keys (VoIP.ms, Stripe, LLM) go in the console's
# vault after the first sign-in, where they can be rotated without a restart.

# ---------------------------------------------------------------- identity --
# Phase 1 (beside the old app): https://telno-new.innotel.site with TELNO_PORT=8081.
# Phase 2 (cutover):            https://telno.innotel.site     with TELNO_PORT=8080.
# TELNO_PORT becomes PORT inside the container; keep it named this way so an
# ambient PORT on the host cannot override the listener.
PUBLIC_URL=https://telno-new.innotel.site
TELNO_PORT=8081
TELNO_HOSTNAME=telno
DEFAULT_COUNTRY=US
TRUST_PROXY=true

# First-run owner. Leave ADMIN_PASSWORD empty: the platform generates one and
# writes it to /data/first-run-password.txt on the volume, never to the log.
ADMIN_EMAIL=admin@innotel.site
ADMIN_PASSWORD=

# ------------------------------------------------------------------ switch --
TELEPHONY_ENABLED=true
AMI_HOST=127.0.0.1
AMI_PORT=5038
AMI_USER=telno
ASTERISK_CONFIG_DIR=/etc/asterisk
ASTERISK_RELOAD=true
# What handsets and browsers are told to send media to. .53 on the LAN.
ASTERISK_EXTERNAL_ADDRESS=192.168.1.53
ASTERISK_LOCAL_NETS=172.16.0.0/12,10.0.0.0/8,192.168.0.0/16

# SIP domain in From/To headers, when the URI you hand out is not the web host.
SIP_DOMAIN=
# 5060/udp SIP, 5038/tcp AMI, 10000-10100/udp RTP are opened by the process on
# the host stack. Nothing else on .53 may own them.

# --------------------------------------------------------------- softphone --
SOFTPHONE_ENABLED=true
# Empty keeps the browser on wss://<console host>/ws and relays it to 8089, so
# the certificate the browser already trusts is the one it uses.
SOFTPHONE_WSS_URL=
SOFTPHONE_WSS_RELAY=true
SOFTPHONE_VIDEO=true
SOFTPHONE_STUN_URLS=stun:stun.l.google.com:19302
# Optional TURN for symmetric NAT; coturn REST credentials.
TURN_URLS=
TURN_SECRET=

# --------------------------------------------------------------------- fax --
# Fax is a call on the switch (res_fax + spandsp), not a carrier API.
FAX_ENABLED=true
# VoIP.ms answers a T.38 renegotiation with 488, so send pages as G.711.
FAX_T38=false
FAX_STATION_ID=Telno

# ------------------------------------------------------------ provisioning --
PROVISIONING_ENABLED=true
PROVISIONING_URL=https://telno.innotel.site
PROVISIONING_SIP_DOMAIN=192.168.1.53
PROVISIONING_SIP_PORT=5060

# ------------------------------------------------------------------ cantus --
# Cantus is the interior voice plane. Until a gateway exists on the LAN leave
# this off: the platform stays on plain SIP and nothing tries to reach 7443.
CANTUS_ENABLED=false
CANTUS_HOST=
CANTUS_PORT=7443
CANTUS_REALM=telno.tel
# The SIP edge an analog adaptor (T750/HT802) registers against when Cantus is on.
CANTUS_SIP_EDGE=

# ------------------------------------------------------------- directory --
DIRECTORY_DOMAINS=telno.directory,num.directory,number.directory,directory.telno.services,directory.pbx.services,directory.pbx.technology
DIRECTORY_CANONICAL=telno.directory
NOTIFY_CHANNEL=console
NOTIFY_FROM=directory@telno.directory

# ---------------------------------------------------------------- billing --
# Keys are better kept in Settings → Vault; these are the .env fallbacks.
PAYMENTS_ENABLED=true
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
VOIPMS_API_USERNAME=
VOIPMS_API_PASSWORD=
VOIPMS_ROUTING=
VOIPMS_POP=1
VOIPMS_BILLING_TYPE=2
RENT_INVOICING_ENABLED=true

# --------------------------------------------------------------------- AI --
AI_ENABLED=true
LLM_BASE_URL=https://gateway.innotel.us/v1
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=

# ----------------------------------------------------------------- backups --
BACKUP_ENABLED=true
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP=7

# ------------------------------------------------------------------- misc --
# A production boot refuses an http PUBLIC_URL on a real hostname because
# session cookies are secure. TLS terminates in front of .53, so keep this false.
ALLOW_INSECURE_PUBLIC_URL=false
APNS_ENABLED=false
PARKING_ENABLED=true
