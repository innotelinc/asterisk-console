# Telno on 192.168.1.53 — copy this to `.env` beside the compose file:
#
#   cp env.53 .env
#
# Every value here is a decision, not a default: the switch's ports are compiled
# in, Cantus has no gateway on the LAN yet, and VoIP.ms refuses T.38. Secrets are
# deliberately absent — session/AMI keys self-generate on the data volume, and
# provider keys belong in Settings → Vault after the first sign-in.

# ---------------------------------------------------------------- identity --
# The console, the API, the public site and the subscriber portal are one
# process, so this is the deployment's main hostname. TLS terminates in the
# reverse proxy; the container speaks http.
PUBLIC_URL=https://telno.innotel.site

# Becomes PORT inside the container. Named TELNO_PORT so an ambient PORT in the
# host's environment cannot silently move the listener. 8080 is the cutover
# value: stop the old app first (see README).
TELNO_PORT=8080
TELNO_HOSTNAME=telno
DEFAULT_COUNTRY=US
TRUST_PROXY=true

# First-run owner. Leave ADMIN_PASSWORD empty: the platform generates one and
# writes it to /data/first-run-password.txt, never to the log. Signing in with
# your own password deletes that file.
ADMIN_EMAIL=admin@innotel.site
ADMIN_PASSWORD=

# ------------------------------------------------------------------ switch --
TELEPHONY_ENABLED=true
# true runs the UI/API against a fake switch; never on .53.
TELEPHONY_SIMULATE=false
AMI_HOST=127.0.0.1
AMI_PORT=5038
AMI_USER=telno
# Empty: generated on first boot and stored on the data volume.
AMI_SECRET=
ASTERISK_CONFIG_DIR=/etc/asterisk
ASTERISK_RELOAD=true
# What handsets and browsers are told to send media to. .53 on the LAN.
ASTERISK_EXTERNAL_ADDRESS=192.168.1.53
ASTERISK_LOCAL_NETS=172.16.0.0/12,10.0.0.0/8,192.168.0.0/16

# SIP domain in From/To headers; the hostname you hand out, not the raw IP.
SIP_DOMAIN=telno.innotel.site

# --------------------------------------------------------------- softphone --
SOFTPHONE_ENABLED=true
# Empty keeps the browser on wss://<console host>/ws, relayed to 8089, so it
# uses the certificate the browser already trusts.
SOFTPHONE_WSS_URL=
SOFTPHONE_WSS_RELAY=true
SOFTPHONE_VIDEO=true
SOFTPHONE_STUN_URLS=stun:stun.l.google.com:19302
# Optional TURN for symmetric NAT; coturn REST credentials.
TURN_URLS=
TURN_SECRET=

# --------------------------------------------------------------------- fax --
# A fax is a call on the switch (res_fax + spandsp), not a carrier API.
FAX_ENABLED=true
# VoIP.ms answers a T.38 renegotiation with 488 and there is no fallback
# mid-call, so pages go as G.711 audio instead. Leave this false.
FAX_T38=false
FAX_STATION_ID=Telno

# ------------------------------------------------------------ provisioning --
PROVISIONING_ENABLED=true
PROVISIONING_URL=https://telno.innotel.site
# The address a handset registers against. The switch's SIP transport is bound
# to 0.0.0.0:5060 and cannot be moved, so this must stay 5060.
PROVISIONING_SIP_DOMAIN=192.168.1.53
PROVISIONING_SIP_PORT=5060

# ------------------------------------------------------------------ cantus --
# Cantus is the interior voice plane. There is no gateway on this LAN, so it
# stays off: the platform speaks plain SIP and nothing tries to reach 7443.
# Turning it on without CANTUS_SIP_EDGE leaves SIP-only handsets with nowhere to
# register, and Cantus puts T.38 out of scope, so fax needs the SIP path anyway.
CANTUS_ENABLED=false
CANTUS_HOST=
CANTUS_PORT=7443
CANTUS_REALM=telno.tel
CANTUS_SIP_EDGE=

# --------------------------------------------------------------- directory --
DIRECTORY_DOMAINS=telno.directory,num.directory,number.directory,directory.telno.services,directory.pbx.services,directory.pbx.technology
DIRECTORY_CANONICAL=telno.directory
NOTIFY_CHANNEL=console
NOTIFY_FROM=directory@telno.directory

# ----------------------------------------------------------------- billing --
# Prefer Settings → Vault for both keys: a vault value wins over these and can
# be rotated without a rebuild. Stripe's webhook endpoint is
# https://telno.innotel.site/api/public/stripe/webhook.
PAYMENTS_ENABLED=true
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ----------------------------------------------------------- number provider --
# Numbers are searched, bought and released at VoIP.ms. Prefer the vault
# (VOIPMS_API_USERNAME / VOIPMS_API_PASSWORD). The API password is generated
# under Main Menu → SOAP & REST/JSON API, where .53's public address must also
# be allow-listed.
VOIPMS_API_USERNAME=
VOIPMS_API_PASSWORD=
# Where a bought DID rings, as a VoIP.ms routing string (account:100001_telno).
VOIPMS_ROUTING=
VOIPMS_POP=1
# 1 = per minute, 2 = flat monthly.
VOIPMS_BILLING_TYPE=2
RENT_INVOICING_ENABLED=true

# ---------------------------------------------------------------------- AI --
# Campaign grading and the operations autopilot go through one OpenAI-compatible
# gateway. Without a key the platform still works and says which path ran.
AI_ENABLED=true
LLM_BASE_URL=https://gateway.innotel.us/v1
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=

# ----------------------------------------------------------------- backups --
BACKUP_ENABLED=true
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP=7

# ------------------------------------------------------------------- misc --
# A production boot refuses an http PUBLIC_URL on a real hostname because session
# cookies are secure. Terminate TLS in the proxy; do not work around it here.
ALLOW_INSECURE_PUBLIC_URL=false
APNS_ENABLED=false
PARKING_ENABLED=true
